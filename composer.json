{
    "name": "assetkiwi/laravel",
    "description": "Laravel integration for AssetKiwi — use AssetKiwi as your asset backend.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "AssetKiwi\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AssetKiwi\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AssetKiwi\\Laravel\\AssetKiwiServiceProvider"
            ],
            "aliases": {
                "AssetKiwi": "AssetKiwi\\Laravel\\Facades\\AssetKiwi"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
